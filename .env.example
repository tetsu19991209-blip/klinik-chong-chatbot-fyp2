# Copy this file to .env and replace every placeholder with your own values.
# Never commit the real .env file.

OPENAI_API_KEY=your_openai_api_key

# Optional: required only for the emergency-call demonstration.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_phone_number
EMERGENCY_CONTACT_NUMBER=your_destination_phone_number

# Runtime paths. Model and database files are intentionally not included.
MBERT_MODEL_PATH=/absolute/path/to/mBert_language_detect_model/best_model
PINYIN2HANZI_HMM_PATH=/absolute/path/to/pinyin2hanzi_hmm_model
XLMR_INTENT_MODEL_PATH=/absolute/path/to/xlmr
KLINIK_CHONG_DB_PATH=/absolute/path/to/klinik_chong.db
KLINIK_CHONG_CHROMA_PATH=/absolute/path/to/chroma_db
KLINIK_CHONG_DATABASE_DIR=/absolute/path/to/database-directory

# Optional external booking service and protected developer interface key.
KLINIK_CHONG_BOOKING_API_BASE=https://your-booking-api.example.com
KLINIK_CHONG_DEVELOPER_API_KEY=replace_with_a_random_private_value
